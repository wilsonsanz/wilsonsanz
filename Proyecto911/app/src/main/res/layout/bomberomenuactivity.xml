<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnVehiculo_Llamas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehiculo en LLamas"
                android:layout_marginEnd="32dp"/>

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_autollamas"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnCasallamas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Casa en Llamas"
                android:color="#43A9CC"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_casallamas"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnRescate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rescate"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_rescate"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>