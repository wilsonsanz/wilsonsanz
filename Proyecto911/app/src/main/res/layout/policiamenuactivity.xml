<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnViolencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Violencia"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_violencia"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnRobo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Robo"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_robo"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnDisparos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disparos"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_disparos"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnPersonaArmada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Persona Armada"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="70dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_persona_armada"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnSecuestro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secuestro"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_secuestro"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnRobo_domicilio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Robo en domicilio"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_robo_domicilio"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnPresunto_delincuente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presunto delincuente"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_presunto_delicuente"
                android:contentDescription="Sicariato" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnSicariato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sicariato"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_sicariato"
                android:contentDescription="Sicariato" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnDesaparecida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desaparacido"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_desaparecida"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnConsumo_droga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consumo de Droga"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_consumo_droga"
                android:contentDescription="Consumo droga" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnLibadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Libadores en via publicaa"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_libadores"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>