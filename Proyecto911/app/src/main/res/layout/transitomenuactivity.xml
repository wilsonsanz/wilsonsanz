<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnAtropello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atropellado"
                android:layout_marginEnd="32dp"/>

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_atropellado"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnChoque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choque de Vehiculos"
                android:color="#43A9CC"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_choque"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnConducteEbrio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conductor Ebrio"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_etilico"
                android:contentDescription="Icono de Robo" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>