<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/futuristic_cyan" />
        </shape>
    </item>

    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/futuristic_cyan"
                android:endColor="@color/futuristic_blue"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/futuristic_border" />
        </shape>
    </item>
</layer-list>