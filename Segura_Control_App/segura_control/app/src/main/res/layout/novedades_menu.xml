<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@drawable/fondo_menu2">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="24dp"
        android:textColor="@android:color/black"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="282dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginTop="80dp">

        <Button
        android:id="@+id/btnNovedades_circulacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:padding="20dp"
        android:textSize="18sp"
        android:text="NOVEDADES EN CIRCULACIÓN"
            style="@style/colorbutton"
        android:textColor="@color/black" />

        <Button
        android:id="@+id/btnPuntomartillo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:padding="20dp"
        android:textSize="18sp"
        android:text="PUNTO MARTILLO"
            style="@style/colorbutton"
        android:textColor="@color/black" />

        <Button
            android:id="@+id/btnLocalSeguro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:padding="20dp"
            android:textSize="18sp"
            android:text="LOCAL SEGURO"
            style="@style/colorbutton"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/btnColaboracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textSize="18sp"
            android:text="COLABORACIÓN ATM-PPNN-ACM"
            style="@style/colorbutton"
            android:textColor="@color/black" />
    </LinearLayout>
</LinearLayout>