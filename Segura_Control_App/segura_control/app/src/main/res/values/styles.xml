<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="colorbutton">colorbutton
        <item name="android:backgroundTint">@color/light_blue</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/black</item>
    </style>



    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Otros atributos -->
        <item name="android:textColor">#000000</item>
    </style>

    <style name="SpinnerItemStyle">
        <item name="android:textColor">@color/green_success</item>
    </style>


    <style name="EditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/edittext_border_rounded

        </item>
        <item name="android:textColor">@color/text_color_primary</item>
        <item name="android:textColorHint">@android:color/darker_gray</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="PlayButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/button_rounded_blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="StopButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/button_rounded_red</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ActionButtonStyleGreen" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/green_success

        </item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>

    <drawable name="button_rounded_blue">
        <shape android:shape="rectangle">
            <solid android:color="@color/blue_primary" />
            <corners android:radius="8dp" />
        </shape>
    </drawable>
    <drawable name="button_rounded_red">
        <shape android:shape="rectangle">
            <solid android:color="@color/red_error" />
            <corners android:radius="8dp" />
        </shape>
    </drawable>

</resources>