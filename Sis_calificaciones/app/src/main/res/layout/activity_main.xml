<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/calificacionInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Introduce tu calificación (0-100)"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/botonCalificar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Obtener calificación"/>

    <TextView
        android:id="@+id/mensajeCalificacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tu calificación será mostrada aquí"
        android:textSize="18sp"
        android:textAlignment="center"
        android:layout_marginTop="16dp"/>
</LinearLayout>
